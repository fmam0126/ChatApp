# ASP.NET Core Server
ASPNETCORE_URLS=http://+:8080
DISABLE_HTTPS_REDIRECTION=true

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
