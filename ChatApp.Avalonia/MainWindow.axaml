<classic:ClassicWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:classic="clr-namespace:Classic.Avalonia.Theme;assembly=Classic.Avalonia.Theme"
        xmlns:vm="using:ChatApp.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
        x:Class="ChatApp.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="GamingChat!!!"
        MinWidth="800" MinHeight="400"
        Width="800" Height="550"
        WindowStartupLocation="CenterScreen"
        Padding="6">

    <classic:ClassicWindow.Resources>
        <DataTemplate x:Key="MessageTemplate" x:DataType="vm:MessageViewModel">
            <TextBlock TextWrapping="Wrap" Margin="2,1" FontSize="12">
                <Run Text="[" Foreground="Gray" />
                <Run Text="{Binding Timestamp}" Foreground="Gray" />
                <Run Text="] " Foreground="Gray" />
                <Run Text="{Binding Username}" Foreground="{Binding UserColor}" />
                <Run Text=": " Foreground="{Binding UserColor}" />
                <Run Text="{Binding Content}" />
            </TextBlock>
        </DataTemplate>
    </classic:ClassicWindow.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!--{Binding IsDisconnected}-->
        <!-- ═══ Login Panel (visible when disconnected) ═══ -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                BorderThickness="2"
                Margin="24"
                Padding="10"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="380" MaxWidth="460"
                
                IsVisible="{Binding IsDisconnected}">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Join Chat"
                           FontSize="12" FontWeight="Bold"
                           Margin="0,-17,0,4" />

                <StackPanel Grid.Row="1" Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Server URL:" FontSize="12" />
                        <TextBox Text="{Binding ServerUrl}"
                                 Watermark="https://localhost:8081"
                                 FontSize="13" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Username:" FontSize="12" />
                        <TextBox Text="{Binding Username}"
                                 Watermark="Enter username (3-30 characters)"
                                 FontSize="13" />
                    </StackPanel>

                    <Button Content="Connect"
                            Command="{Binding ConnectCommand}"
                            HorizontalAlignment="Left"
                            MinWidth="80" Margin="0,6,0,0" />

                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- {Binding IsConnected}-->
        <!-- ═══ Chat Panel (visible when connected) ═══ -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                BorderThickness="2"
                Margin="4"
                Padding="8"
                
                IsVisible="{Binding IsConnected}"
                >
                
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="Chat"
                           FontSize="12" FontWeight="Bold"
                           Margin="-6,-16,0,4" />

                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            Spacing="8" Margin="0,0,0,4">
                    <TextBlock Text="Connected as:" FontSize="12" />
                    <TextBlock Text="{Binding Username}"
                               FontSize="12" FontWeight="Bold" />
                    <Button Content="Disconnect"
                            Command="{Binding DisconnectCommand}"
                            MinWidth="80" />
                </StackPanel>

                <!-- Messages -->
                <ListBox x:Name="MessagesListBox"
                         Grid.Row="2"
                         ItemsSource="{Binding Messages}"
                         ItemTemplate="{StaticResource MessageTemplate}"
                         BorderThickness="2"
                         Margin="0,0,0,4" />

                <!-- Input area -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" >
                    
                        <TextBox x:Name="MessageInput"
                                 Text="{Binding MessageText}"
                                 Watermark="Type a message"
                                 FontSize="13"
                                 KeyDown="MessageInput_KeyDown"
                                 Width="682"/>

                        <Button Content="Send"
                                Command="{Binding SendMessageCommand}"
                                MinWidth="64" />
                    
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Status Bar ═══ -->
        <Border Grid.Row="2"
                BorderThickness="1"
                Padding="4,2">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11" />
        </Border>
    </Grid>
</classic:ClassicWindow>
