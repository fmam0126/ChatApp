# ── ChatApp.Blazor Docker ignore ──
# This file documents exclusions for the ChatApp.Blazor Docker image.
# When building from the repo root (docker-compose), the root .dockerignore applies.

# ── IDE & editor ──
**/.vs
**/.vscode
**/*.*proj.user

# ── Build output ──
**/bin
**/obj
**/TestResults

# ── Git & Claude ──
**/.git
**/.claude

# ── Docker / Compose ──
**/docker-compose*
**/Dockerfile*
**/.dockerignore

# ── Environment & secrets ──
**/.env
**/.env.example
**/secrets.dev.yaml

# ── Documentation ──
**/*.md
LICENSE

# ── Solution files ──
*.slnx
*.slnLaunch.user

# ── CI / CD ──
**/.github

# ── Infrastructure config ──
prometheus
grafana
traefik

# ── Other projects in monorepo ──
ChatApp.Avalonia
ChatApp.CliClient
ChatApp.server
ChatApp.Server.Tests

# ── Static assets / misc ──
windows98-icons
skills

# ── Keep specific files ──
!**/.gitignore
