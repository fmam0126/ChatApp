@page "/"
@rendermode InteractiveWebAssembly
@using ChatApp.Blazor.Models
@using ChatApp.Blazor.Services
@using ChatApp.Blazor.Components
@inject WindowManager Manager
@implements IDisposable

<PageTitle>ChatApp - Windows 95</PageTitle>

<div class="win95-desktop" @onclick="HandleDesktopClick">
    <div class="desktop-icons-area">
        <DesktopIcon Title="Chat Client" IconSrc="icons/chat.png" OnDoubleClick="OpenChatWindow" />
    </div>

    <div class="desktop-windows-area">
        @foreach (var w in Manager.OpenWindows.OrderBy(w => w.ZIndex))
        {
            <DesktopWindow State="w">
                <ChatWindowContent Window="w" />
            </DesktopWindow>
        }
    </div>

    <Taskbar />
</div>


@code {
    protected override void OnInitialized()
    {
        Manager.OnChanged += HandleWindowsChanged;
    }

    private void HandleWindowsChanged() => InvokeAsync(StateHasChanged);

    private void OpenChatWindow()
    {
        Manager.OpenWindow(WindowContentType.Chat, "Welcome to ChatApp");
    }

    private void HandleDesktopClick() => StateHasChanged();

    public void Dispose()
    {
        Manager.OnChanged -= HandleWindowsChanged;
    }
}
